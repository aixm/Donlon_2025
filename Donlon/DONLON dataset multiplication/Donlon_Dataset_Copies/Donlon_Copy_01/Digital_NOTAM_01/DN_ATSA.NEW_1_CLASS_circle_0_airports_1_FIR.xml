<!-- 
  Example of Digital NOTAM for ad-hoc ATS airspace creation:
  
                   Type: CLASS
                  Class: A
      Activation status: ACTIVE
             Designator: EAAD000128
             Start Time: 2028-02-15 10:00
               End Time: 2028-02-15 20:00
                   Name: -
               Schedule: -
               Geometry: Circle by centerpoint and radius (10NM)
    Horizontal accuracy: 5 M
            Lower Limit: GND
  Lower Limit Reference: -
            Upper Limit: FL050
  Upper Limit Reference: STD
      Excluded airspace: -
  Affected Aerodrome(s): -
        Affected FIR(s): EAAD
          Location Note: -
  Controlling Unit Note: -
                   Note: -
-->

<!-- 
  B NOTAMN
  Q) EAAD/QXXXX/IV/NBO/E/000/050/5601N03418W010
